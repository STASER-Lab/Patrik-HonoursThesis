{
  "version": 2,
  "description": "Query latency and throughput of the four layouts, against an existing cluster",
  "challenges": [
    {
      "name": "latency",
      "description": "One client. Every verified query, repository and layout, layouts interleaved",
      "default": true,
      "schedule": [
        {% for c in combos %}
        {
          "operation": {
            "name": "{{ c.query }}-{{ c.repo }}-{{ c.layout }}",
            "operation-type": "layout-query",
            "query": "{{ c.query }}",
            "layout": "{{ c.layout }}",
            "tier": "{{ tier }}",
            "repo_id": {{ c.repo_id }}
          },
          "clients": 1,
          "warmup-iterations": {{ warmup | default(20) }},
          "iterations": {{ iterations | default(200) }}
        }{{ "," if not loop.last }}
        {% endfor %}
      ]
    }
  ]
}
