{
  "version": 2,
  "description": "Query latency and throughput of the four layouts, against an existing cluster",
  "challenges": [
    {
      "name": "latency",
      "description": "One client. Verified queries, repositories and interleaved layouts",
      "default": true,
      "schedule": [
        {% for c in combos %}
        {
          "operation": {
            "name": "{{ c.query }}-{{ c.repo }}-{{ c.layout }}",
            "operation-type": "layout-query",
            "query": "{{ c.query }}",
            "layout": "{{ c.layout }}",
            "tier": "{{ tier }}",
            "repo_id": {{ c.repo_id }}
          },
          "clients": 1,
          "warmup-iterations": {{ warmup }},
          "iterations": {{ iterations }}
        }{{ "," if not loop.last }}
        {% endfor %}
      ]
    },
    {
      "name": "throughput",
      "description": "Several clients per layout, each sending a random mix of its verified queries and repositories",
      "schedule": [
        {% for layout in layouts %}
        {
          "operation": {
            "name": "mix-{{ layout }}",
            "operation-type": "layout-query",
            "param-source": "layout-mix",
            "layout": "{{ layout }}",
            "tier": "{{ tier }}",
            "mix": {{ mix[layout] | tojson }},
            "seed": {{ seed }}
          },
          "clients": {{ clients }},
          "warmup-time-period": {{ throughput_warmup }},
          "time-period": {{ throughput_time }}
        }{{ "," if not loop.last }}
        {% endfor %}
      ]
    }
  ]
}
